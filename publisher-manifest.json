adding:14px 16px;border-bottom:1px solid #e2e2e2;vertical-align:top;text-align:left}\n  thead th{background:var(--paper);border-bottom:3px solid var(--line);font-size:15px}\n  thead th .plan-name{display:block;font-size:18px;font-weight:800}\n  thead th .plan-price{display:block;color:var(--orange-deep);font-weight:800;font-size:16px;margin-top:4px}\n  thead th .plan-year{display:block;font-size:12.5px;color:var(--ink-soft);font-weight:400;margin-top:2px}\n  th.featured,td.featured{background:var(--tint)}\n  thead th.featured{box-shadow:inset 0 4px 0 var(--orange)}\n  .badge{display:inline-block;background:var(--orange);color:#fff;font-size:11px;font-weight:700;letter-spacing:.1em;padding:2px 8px;margin-bottom:6px}\n  tbody th{font-weight:700;white-space:nowrap;background:#fafafa;width:150px}\n  tbody tr:last-child th,tbody tr:last-child td{border-bottom:none}\n  .yes{font-weight:700}\n\n  /* 双栏问答 */\n  .faq-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 34px}\n  .qa{border-top:3px solid var(--line);padding:18px 0 20px}\n  .qa h3{font-size:17px;margin-bottom:6px}\n  .qa h3::before{content:\"Q\";display:inline-block;color:#fff;background:var(--orange);font-size:12px;font-weight:800;width:20px;height:20px;line-height:20px;text-align:center;margin-right:9px;vertical-align:2px}\n  .qa p{margin:0;color:var(--ink-soft);font-size:15px;padding-left:29px}\n\n  /* 客户端区块 */\n  .clients{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px;margin-top:8px}\n  .client{border:3px solid var(--line);padding:20px}\n  .client h3{margin-bottom:6px;font-size:18px}\n  .client .os{font-size:12px;font-weight:700;letter-spacing:.12em;color:var(--orange-deep);display:block;margin-bottom:8px}\n  .client p{font-size:14.5px;color:var(--ink-soft);margin-bottom:10px}\n  .client .dl{font-size:13.5px;color:var(--ink);border-top:1px dashed #bfbfbf;padding-top:10px;display:block}\n  .client .dl a{color:var(--orange-deep);font-weight:700;text-decoration:none;border-bottom:2px solid var(--orange)}\n\n  .steps{counter-reset:step;list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}\n  .steps li{counter-increment:step;border:3px solid var(--line);padding:18px 18px 20px;margin:0;font-size:15px;color:var(--ink-soft)}\n  .steps li::before{content:counter(step,decimal-leading-zero);display:block;font-size:30px;font-weight:800;color:var(--orange);line-height:1;margin-bottom:8px}\n  .steps li b{display:block;color:var(--ink);font-size:16px;margin-bottom:4px}\n\n  .foot{padding:34px 0 60px;font-size:13.5px;color:var(--ink-soft)}\n  .foot strong{color:var(--ink)}\n\n  @media (max-width:860px){\n    .shell{display:block}\n    .rail{width:auto;flex:none;position:sticky;top:0;height:auto;border-right:none;border-bottom:3px solid var(--line);padding:14px 20px 12px;gap:12px;z-index:5}\n    .rail-brand{font-size:21px}\n    .rail-note{display:none}\n    .rail-nav{flex-direction:row;flex-wrap:wrap;gap:0 18px}\n    .rail-nav a{padding:5px 0;font-size:13.5px;border-bottom:none}\n    .rail-nav a i{display:none}\n    .wrap{padding:0 20px}\n    section{padding:42px 0}\n    .hero{padding:34px 0 46px}\n    .faq-grid{grid-template-columns:1fr;gap:0}\n    .faq-grid .qa:first-child{border-top:3px solid var(--line)}\n  }\n</style><div class=\"shell\">\n  <aside class=\"rail\">\n    <div class=\"rail-brand\">Doctor<span>.</span></div>\n    <nav class=\"rail-nav\" aria-label=\"页面目录\">\n      <a href=\"#story\"><i>01</i>从哪儿入手</a>\n      <a href=\"#plans\"><i>02</i>套餐对比</a>\n      <a href=\"#clients\"><i>03</i>客户端</a>\n      <a href=\"#howto\"><i>04</i>上手顺序</a>\n      <a href=\"#faq\"><i>05</i>常见问题</a>\n    </nav>\n    <div class=\"rail-note\">\n      Doctor 是一份把话说明白的订阅说明页。价格、权益、设备数都写在明面上，你自己对号入座就好。\n    </div>\n  </aside>\n\n  <main>\n    <div class=\"wrap\">\n\n      <header class=\"hero\" id=\"story\">\n        <span class=\"hero-kicker\">DOCTOR · 说明文档</span>\n        <h1>别急着买，先让 <em>Doctor</em> 帮你把网络这件事捋顺</h1>\n        <p class=\"hero-lead\">很多人是在某个晚上突然发现网络不对劲，才开始翻资料。这一页就按那个晚上的顺序写：先弄清楚自己卡在哪，再对比套餐，最后挑客户端。不用一次看懂，往下走就行。</p>\n\n        <ol class=\"timeline\">\n          <li>\n            <b>第一步：说清楚你遇到的是什么</b>\n            <span>看视频一直转圈、远程开会断断续续、游戏延迟跳来跳去——这三件事需要的方案不一样。先给自己归个类。</span>\n          </li>\n          <li>\n            <b>第二步：把预算和设备数摆出来</b>\n            <span>你一个人用，还是一家人共用？手机、电脑、平板加起来几台？这决定了你该看哪一档。</span>\n          </li>\n          <li>\n            <b>第三步：对着表格选套餐</b>\n            <span>流量、设备数、节点类型一行一行看，不用听推荐，表格本身就是答案。</span>\n          </li>\n          <li>\n            <b>第四步：装好客户端，跑一次</b>\n            <span>装完先跑一遍日常操作，确认顺了，再决定要不要换成按年付。</span>\n          </li>\n        </ol>\n\n        <p class=\"hero-jump\">已经想好了？<a href=\"#plans\">直接看套餐对比表 →</a></p>\n      </header>\n\n      <section id=\"why\">\n        <h2>Doctor 想先讲清楚的三件事</h2>\n        <p class=\"sec-lead\">不绕弯子。下面这三条是我们觉得最该在你掏钱之前就知道的。</p>\n        <div class=\"cards\">\n          <article class=\"card\">\n            <span class=\"tagline\">关于价格</span>\n            <h3>按月、按年，两条路都摆出来</h3>\n            <p>每一档都有月付价和年付价，年付便宜多少自己一算就明白。我们不藏起便宜的那条路，也不逼你一次付很久。</p>\n          </article>\n          <article class=\"card accent\">\n            <span class=\"tagline\">关于档位</span>\n            <h3>三档，是按人数分的</h3>\n            <p>基础版适合一个人日常用，旗舰版适合一两个人加一点重度需求，团队版是按十几二十台设备来设计的。别为了「更高级」多花钱。</p>\n          </article>\n          <article class=\"card\">\n            <span class=\"tagline\">关于不确定</span>\n            <h3>拿不准就先问</h3>\n            <p>下面常见问题里没写到的，先别付款。把使用场景说清楚，再决定买哪一档，比买错了退来退去省事得多。</p>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"plans\">\n        <h2>三档套餐，一行一行对比</h2>\n        <p class=\"sec-lead\">横向看是同一项在不同档位上的差别，纵向看是某一档的全部内容。表格里的数字就是最终数字。</p>\n\n        <div class=\"table-scroll\">\n          <table>\n            价格为月付标准价，年付价单独列出；表中“设备”指同时在线设备数量。\n            <thead>\n              <tr>\n                <th>对比项</th>\n                <th>\n                  <span class=\"plan-name\">基础版</span>\n                  <span class=\"plan-price\">¥15 / 月</span>\n                  <span class=\"plan-year\">按年付 ¥150 / 年</span>\n                </th>\n                <th class=\"featured\">\n                  <span class=\"badge\">多数人选这档</span>\n                  <span class=\"plan-name\">旗舰版</span>\n                  <span class=\"plan-price\">¥35 / 月</span>\n                  <span class=\"plan-year\">按年付 ¥350 / 年</span>\n                </th>\n                <th>\n                  <span class=\"plan-name\">团队版</span>\n                  <span class=\"plan-price\">¥85 / 月</span>\n                  <span class=\"plan-year\">按年付 ¥850 / 年</span>\n                </th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <th>每月流量</th>\n                <td>100GB</td>\n                <td class=\"featured\">300GB</td>\n                <td>1000GB</td>\n              </tr>\n              <tr>\n                <th>同时在线设备</th>\n                <td>3 台</td>\n                <td class=\"featured\">5 台</td>\n                <td>20 台</td>\n              </tr>\n              <tr>\n                <th>流媒体解锁</th>\n                <td>基础流媒体</td>\n                <td class=\"featured\">全节点原生流媒体解锁</td>\n                <td>全节点原生流媒体解锁</td>\n              </tr>\n              <tr>\n                <th>线路类型</th>\n                <td>普通线路节点池</td>\n                <td class=\"featured\">IPLC 专线，游戏加速优化</td>\n                <td>VIP 专属高带宽节点</td>\n              </tr>\n              <tr>\n                <th>企业定制路由</th>\n                <td>—</td>\n                <td class=\"featured\">—</td>\n                <td>支持</td>\n              </tr>\n              <tr>\n                <th>支持方式</th>\n                <td>常规工单</td>\n                <td class=\"featured\">7×24 优先工单支持</td>\n                <td>专属客户经理服务</td>\n              </tr>\n              <tr>\n                <th>适合谁</th>\n                <td>一个人、一台手机一台电脑，白天刷片晚上看新闻</td>\n                <td class=\"featured\">手机电脑平板都挂着，偶尔打游戏、常看剧</td>\n                <td>小团队、家里多设备、需要统一调配的人</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n\n        <p>年付金额就是把 12 个月的月付价按十个月收，多的两个月算我们请客。什么时候从月付换年付都行，不必一开始就决定。</p>\n      </section>\n\n      <section id=\"clients\">\n        <h2>客户端：装在哪儿，怎么装</h2>\n        <p class=\"sec-lead\">Doctor 不自己做客户端。你用的是系统或常见工具里已有的那一套，我们只负责把配置和参数交代清楚。具体下载请以各平台官方渠道为准。</p>\n\n        <div class=\"clients\" id=\"clients-grid\">\n          <article class=\"client\">\n            <span class=\"os\">iOS / iPadOS</span>\n            <h3>在 App Store 里挑一个</h3>\n            <p>从 App Store 搜索并安装你习惯的网络配置工具，按 Doctor 提供的配置方式添加。地区账号差异会影响上架情况，以你所在商店实际搜索结果为准。</p>\n            <span class=\"dl\">下载地址：<a href=\"#\">见使用说明中的渠道指引</a></span>\n          </article>\n          <article class=\"client\">\n            <span class=\"os\">Android</span>\n            <h3>用应用商店或官方页面</h3>\n            <p>优先从系统应用商店安装。若商店没有，请只从工具官方页面获取安装包，不要装来路不明的文件。</p>\n            <span class=\"dl\">下载地址：<a href=\"#\">以工具官方页面为准</a></span>\n          </article>\n          <article class=\"client\">\n            <span class=\"os\">macOS</span>\n            <h3>桌面端，装完要授权</h3>\n            <p>macOS 首次运行通常需要在系统设置里允许网络扩展或代理权限，按提示点允许即可，不必改系统其他设置。</p>\n            <span class=\"dl\">下载地址：<a href=\"#\">以工具官方页面为准</a></span>\n          </article>\n          <article class=\"client\">\n            <span class=\"os\">Windows</span>\n            <h3>家用电脑最常见的选择</h3>\n            <p>安装后首次运行请允许其添加网络组件。若安全软件拦截，请确认来源后再放行。</p>\n            <span class=\"dl\">下载地址：<a href=\"#\">以工具官方页面为准</a></span>\n          </article>\n        </div>\n\n        <p>我们不会在这个页面托管安装包，也不提供来路不明的镜像地址。任何以 Doctor 名义索要账号密码或要求你私下转账的，都不是我们。</p>\n      </section>\n\n      <section id=\"howto\">\n        <h2>装好之后的四步</h2>\n        <p class=\"sec-lead\">顺序不重要，但按这个顺序走最不容易漏东西。</p>\n        <ol class=\"steps\">\n          <li>\n            <b>先确认网络本身是通的</b>\n            不开任何工具，先看看普通网页打得开不开。本地网络有问题的话，后面怎么调都没用。\n          </li>\n          <li>\n            <b>再装客户端、填配置</b>\n            照着使用说明把配置填进去，保存。别一次改太多项，出问题不好排查。\n          </li>\n          <li>\n            <b>跑一遍你真正要做的事</b>\n            打开你平时看的视频、要开的会议、要打的游戏，各试三分钟。比看任何测速数字都准。\n          </li>\n          <li>\n            <b>稳住之后再考虑年付</b>\n            连续用上一阵子确认顺手，再算年付划不划算。临时需求按月付就好。\n          </li>\n        </ol>\n      </section>\n\n      <section id=\"faq\">\n        <h2>常见问题</h2>\n        <p class=\"sec-lead\">左边是刚接触的人最常问的，右边是准备长期用的人会更在意的。</p>\n\n        <div class=\"faq-grid\">\n          <article class=\"qa\">\n            <h3>我该怎么判断自己该选哪一档？</h3>\n            <p>先数设备，再看流量。一个人两台设备、每天看一两个小时视频，基础版够用；设备到四五台、常看高清或者打游戏，看旗舰版；超过五台设备或者要给团队一起用，才轮到团队版。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h3>年付是不是必须一次付清？</h3>\n            <p>年付就是一次付一整年，换来的是一年里只收十个月的钱。如果你还没确定要长期用，先月付几个月，确认顺手了再换成年付，这样更稳。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h3>设备数是怎么算的？</h3>\n            <p>按同时在线算。手机和电脑同时在用就算两台；关掉一台、换平板登录，还是两台。所以不是总设备数，而是同一时间挂着的数量。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h3>流量超了会怎么样？</h3>\n            <p>每月流量按自然月计算，用完了当月就停下来，不会自动加钱，也不会悄悄扣费。不够用的话下个月换到更高一档，或者当月就先控制一下使用。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h3>我不太懂技术，配置会不会很麻烦？</h3>\n            <p>配置这件事本身不复杂：装好客户端，把使用说明里的参数照着填进去，保存。真遇到卡住的地方，把界面截图和报错文字发过来，比描述「连不上」有用得多。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h3>用起来慢，先查什么？</h3>\n            <p>顺序建议是：先确认本地网络正常，再看是不是同时挂着太多设备，然后换一个线路试试，最后才考虑升档。多数情况下问题出在前两步，不是套餐不够。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h3>团队版和企业定制路由是给谁用的？</h3>\n            <p>给需要多人共用、并且希望统一管理访问规则的小团队。如果只是家里三四台设备，旗舰版就够了，不必为了「团队」两个字多花钱。</p>\n          </article>\n\n          <article class=\"qa\">\n            <h3>换了设备还要重新弄一遍吗？</h3>\n            <p>要重新装客户端、填一次配置，参数是同一套。建议把配置信息自己存在可靠的地方，换机时省事。别把它随手发在群里或公开贴出来。</p>\n          </article>\n        </div>\n      </section>\n\n      <footer class=\"foot\">\n        <p><strong>Doctor</strong> · 把网络这件事讲清楚。本页只做套餐与使用方式说明，价格与权益以页面所列内容为准；未在此列出的服务与承诺，我们不代为代表。</p>\n      </footer>\n\n    </div>\n  </main>\n</div>",
